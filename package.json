{
  "name": "dsh-token-monitor",
  "version": "1.3.2",
  "description": "Privacy-first provider-reported token usage dashboard for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1 <0.2.0 || 0.1.3-alpha.1",
      "dshReleases": {
        "rc.7": "compatible",
        "rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node --check src/index.mjs && node --check src/model-usage-projection.mjs && node --check src/client.js && node --check src/metrics.js && node --check src/heatmap.js && npm test",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1 <0.2.0 || 0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.2.0 || 0.1.3-alpha.1",
    "react": ">=18.2.0"
  },
  "license": "MIT"
}
